# Prefer pnpm setup:env to generate independent random secrets (never committed).
APP_URL=http://localhost:3100
PORT=3100
POSTGRES_PORT=55432
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
APP_DB_PASSWORD=REPLACE_WITH_RANDOM_RUNTIME_PASSWORD
DATABASE_URL=postgresql://agent_chat_app:REPLACE_WITH_RANDOM_RUNTIME_PASSWORD@127.0.0.1:55432/agent_chat
MIGRATION_DATABASE_URL=postgresql://agent_chat:REPLACE_WITH_RANDOM_OWNER_PASSWORD@127.0.0.1:55432/agent_chat
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SETUP_TOKEN=REPLACE_WITH_RANDOM_ONE_TIME_SETUP_SECRET
# Only for a loopback development origin. Set false before public hosting.
ALLOW_LOCAL_SETUP=true
FILES_DIR=./data/files
MAX_FILE_BYTES=10485760
# Compose only: match the host user that owns data/files. setup:env fills these.
# LOCAL_UID=1000
# LOCAL_GID=1000
# Optional: a disposable database, never production. Tests reset its public schema.
# TEST_DATABASE_URL=postgresql://test_owner:TEST_ONLY@127.0.0.1:55432/agent_chat_test
# Optional PostgreSQL binary directory if pg_dump/pg_restore are not on PATH.
# PG_BIN_DIR=/opt/homebrew/opt/postgresql@18/bin
