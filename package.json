{
  "name": "agent-chat",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3100",
    "generate-routes": "vite build",
    "build": "node scripts/migration-manifest.mjs --check && vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix .",
    "check": "prettier --check .",
    "start": "tsx scripts/start.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/migrate.ts --status",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "cli": "node public/agent-chat.mjs",
    "doctor": "tsx scripts/doctor.ts",
    "backup": "tsx scripts/backup.ts",
    "release:check": "tsx scripts/release-check.ts",
    "setup:env": "node scripts/setup-env.mjs",
    "restore": "tsx scripts/restore.ts",
    "release:version": "node scripts/version.mjs",
    "account:recover": "tsx scripts/reset-owner.ts",
    "build:cloudflare": "node scripts/migration-manifest.mjs --check && vite build --config vite.cloudflare.config.ts",
    "dev:cloudflare": "vite dev --config vite.cloudflare.config.ts",
    "db:manifest": "node scripts/migration-manifest.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "better-auth": "1.7.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "dotenv": "18.0.10",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260610-beta",
    "pg": "8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.3.6",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.68.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/eslint-config": "0.5.0",
    "@types/node": "^22.10.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "workerd"
    ],
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "11.0.5",
      "postcss-selector-parser@<6.1.5": "6.1.5"
    }
  },
  "version": "0.4.1",
  "license": "Apache-2.0",
  "description": "Personal, self-hosted chat for you and your agents.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "bin": {
    "agent-chat": "public/agent-chat.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vecbase-labs/agent-chat.git"
  },
  "homepage": "https://github.com/vecbase-labs/agent-chat#readme",
  "bugs": {
    "url": "https://github.com/vecbase-labs/agent-chat/issues"
  },
  "author": "Ray (https://github.com/builtbyray)"
}
